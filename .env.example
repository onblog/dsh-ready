# Desktop build variables (copy to `.env`, which is git-ignored).
#
# `scripts/write-site-config.cjs` reads these at packaging time and writes
# `electron/site.generated.json` into the app bundle. Nothing here is required:
# without them the app disables launch reporting / update checks and hides the
# contact entry.
#
# The live origin and mailbox must never be committed — that is why the app takes
# them from the build environment instead of the source tree.

SITE_URL=https://example.com
CONTACT_EMAIL=you@example.com
